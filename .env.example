# ANUBIS Core — environment configuration (copy to .env, never commit it)
# Only NON-SECRET knobs belong here. The Telegram token is required.

# REQUIRED — Telegram bot token (BotFather). Keep secret.
ANUBIS_TELEGRAM_TOKEN=your_bot_token_here

# Path to config.toml (optional; defaults to ./config.toml)
# ANUBIS_CONFIG=./config.toml

# Noxis Core local LLM endpoint (llama.cpp / ollama compatible OpenAI-style API)
# Leave empty to disable /ask.
ANUBIS_LLM_URL=http://127.0.0.1:8080
# Optional API key for a hosted OpenAI-compatible endpoint (e.g. omniroute).
# Send /ask through it: ANUBIS_LLM_URL=https://api.omniroute.ai  ANUBIS_LLM_KEY=...
ANUBIS_LLM_KEY=

# Chatterbox (MIT) voice-clone server
ANUBIS_CLONE_URL=http://127.0.0.1:8008

# Kokoro (Apache-2.0) TTS sidecar (optional, CPU)
ANUBIS_KOKORO_URL=http://127.0.0.1:8880

# Local whisper.cpp sidecar for voice-to-voice transcription (optional; run ./scripts/whisper.sh)
ANUBIS_WHISPER_URL=http://127.0.0.1:8890

# Real-time WebSocket transport (opcode protocol) — runs alongside the bot.
# Bind address and optional shared bearer token. Leave token empty for local.
ANUBIS_WS_BIND=127.0.0.1:7600
ANUBIS_WS_TOKEN=

# Logging verbosity: anubis=info,teloxide=warn
RUST_LOG=anubis=info
